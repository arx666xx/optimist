<Window x:Class="NetOptimizer.RepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ремонт сети"
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🛠 Ремонт сетевых настроек" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"
                   Text="Стандартные средства Windows для восстановления соединения после VPN. Если интернет есть, но игры (Steam) и часть программ выдают ошибки — начните со «Сброса Winsock». После сброса Winsock и TCP/IP нужна перезагрузка."/>

        <!-- Steam fix (label + button, no box) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Проблема с играми / Steam (ошибки при рабочем интернете):" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Button x:Name="BtnSteamFix" Content="Исправить — сброс Winsock *" HorizontalAlignment="Left"
                    Style="{StaticResource Btn}" Click="SteamFix_Click"/>
        </StackPanel>

        <!-- Individual actions -->
        <StackPanel Grid.Row="3">
            <WrapPanel>
                <Button x:Name="BtnFlush"    Content="Очистить кэш DNS"        Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Flush_Click"/>
                <Button x:Name="BtnRenew"    Content="Обновить IP-адрес"       Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Renew_Click"/>
                <Button x:Name="BtnWinsock"  Content="Сбросить Winsock *"      Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Winsock_Click"/>
                <Button x:Name="BtnTcpip"    Content="Сбросить TCP/IP *"       Style="{StaticResource Btn}" Margin="0,0,8,8" Click="TcpIp_Click"/>
                <Button x:Name="BtnFirewall" Content="Сбросить брандмауэр"     Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Firewall_Click"/>
                <Button x:Name="BtnFull"     Content="Полный сброс сети *"     Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Full_Click"/>
            </WrapPanel>

            <TextBlock Text="* — потребуется перезагрузка компьютера (по таймеру из настроек)."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>

            <TextBlock Text="Журнал:" Margin="0,10,0,4" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="LogBox" Height="240" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Background="{DynamicResource PanelBrush}"
                     Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                     BorderThickness="1" Padding="8"/>
        </StackPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="Hint" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       Text="Готово."/>
            <Button Content="Закрыть" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Close_Click"/>
            <Button x:Name="BtnReboot" Content="Перезагрузить сейчас" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Reboot_Click"/>
        </DockPanel>
    </Grid>
</Window>

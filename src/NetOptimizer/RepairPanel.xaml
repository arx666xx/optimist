<UserControl x:Class="NetOptimizer.RepairPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Right margin leaves room for the host's ✕ button. -->
        <StackPanel Grid.Row="0" Margin="0,0,48,16">
            <TextBlock Text="Ремонт сетевых настроек" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12"
                       Text="Стандартные средства Windows для восстановления соединения после VPN. Если интернет есть, но игры и часть программ выдают ошибки — начните со сброса Winsock. После сброса Winsock и TCP/IP нужна перезагрузка."/>
        </StackPanel>

        <!-- Primary fix -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ИГРЫ И STEAM НЕ РАБОТАЮТ" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBlock Text="Интернет есть, но приложения выдают ошибки соединения"
                               Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="BtnSteamFix" Content="Исправить  ·  сброс Winsock *" MinWidth="220" DockPanel.Dock="Right"
                        Style="{StaticResource BtnAccent}" Click="SteamFix_Click"/>
            </DockPanel>
        </Border>

        <!-- Individual actions -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="ОТДЕЛЬНЫЕ ДЕЙСТВИЯ" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
            <UniformGrid Columns="3">
                <Button x:Name="BtnFlush"    Content="Очистить кэш DNS"    Style="{StaticResource Btn}" MinWidth="0" Margin="0,0,8,8" Click="Flush_Click"/>
                <Button x:Name="BtnRenew"    Content="Обновить IP-адрес"   Style="{StaticResource Btn}" MinWidth="0" Margin="0,0,8,8" Click="Renew_Click"/>
                <Button x:Name="BtnWinsock"  Content="Сбросить Winsock *"  Style="{StaticResource Btn}" MinWidth="0" Margin="0,0,0,8" Click="Winsock_Click"/>
                <Button x:Name="BtnTcpip"    Content="Сбросить TCP/IP *"   Style="{StaticResource Btn}" MinWidth="0" Margin="0,0,8,8" Click="TcpIp_Click"/>
                <Button x:Name="BtnFirewall" Content="Сбросить брандмауэр" Style="{StaticResource Btn}" MinWidth="0" Margin="0,0,8,8" Click="Firewall_Click"/>
                <Button x:Name="BtnFull"     Content="Полный сброс сети *" Style="{StaticResource Btn}" MinWidth="0" Margin="0,0,0,8" Click="Full_Click"/>
            </UniformGrid>
            <TextBlock Margin="0,2,0,14" Style="{StaticResource Muted}" FontSize="12"
                       Text="* — потребуется перезагрузка компьютера (по таймеру из настроек)."/>
        </StackPanel>

        <!-- Log -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="ЖУРНАЛ" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource ConsoleBox}"
                     TextWrapping="NoWrap" MinHeight="80"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Reboot notice (was a separate window) -->
        <Border x:Name="RebootBanner" Grid.Row="4" Style="{StaticResource Card}" Padding="16,12"
                Margin="0,14,0,0" BorderBrush="{DynamicResource WarnBrush}" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="RebootTitle" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                    <TextBlock x:Name="RebootText" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Отмена" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="9,0,0,0"
                        Click="RebootCancel_Click"/>
                <Button Content="Перезагрузить сейчас" DockPanel.Dock="Right" Style="{StaticResource BtnAccent}"
                        Click="RebootNow_Click"/>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="Hint" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="Готово."/>
            <Button x:Name="BtnReboot" Content="Перезагрузить сейчас" DockPanel.Dock="Right"
                    Style="{StaticResource Btn}" Click="Reboot_Click"/>
        </DockPanel>
    </Grid>
</UserControl>

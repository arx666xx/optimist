<Window x:Class="NetOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOptimizer — сетевые соединения"
        Height="740" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Net" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Optimizer" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="сетевые соединения" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="12,3,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="12,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="FilterBox" Width="240" Style="{StaticResource SearchBox}" TextChanged="FilterBox_TextChanged"/>
                <CheckBox x:Name="HideLoopback" Content="Скрыть локальные" Margin="14,0,0,0" Click="Filter_Changed"/>
                <CheckBox x:Name="OnlyActive" Content="Только активные" Margin="14,0,0,0" Click="Filter_Changed"/>
                <CheckBox x:Name="OnlySuspicious" Content="Подозрительные" Margin="14,0,0,0" Click="Filter_Changed"/>
                <CheckBox x:Name="GroupByProcess" Content="Группировать" Margin="14,0,0,0" Click="GroupBy_Changed"/>

                <Button Content="Обновить" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Btn}" Click="Refresh_Click"/>
                <CheckBox x:Name="AutoRefresh" Content="Авто" DockPanel.Dock="Right" Margin="8,0,0,0" IsChecked="True" Click="AutoRefresh_Changed" VerticalAlignment="Center"/>
                <Button Content="🛠 Ремонт сети" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Btn}" Click="Repair_Click"/>
                <Button x:Name="BtnUpdate" Content="Обновления" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Btn}" Click="Update_Click"/>
            </DockPanel>
        </Border>

        <!-- Grid -->
        <DataGrid x:Name="ConnGrid" Grid.Row="2"
                  Style="{StaticResource Dg}" RowStyle="{StaticResource DgRow}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserResizeRows="False"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  PreviewMouseRightButtonDown="ConnGrid_RightClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" Width="75"/>
                <DataGridTemplateColumn Header="Процесс" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ProcessPath}">
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       Margin="0,0,8,0" SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Программа / сервис" Binding="{Binding Description}" Width="180"/>
                <DataGridTextColumn Header="↓ Приём" Binding="{Binding DownloadRateText}" Width="90"/>
                <DataGridTextColumn Header="↑ Отдача" Binding="{Binding UploadRateText}" Width="90"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                <DataGridTextColumn Header="Локальный адрес" Binding="{Binding LocalEndpoint}" Width="160"/>
                <DataGridTextColumn Header="Удалённый адрес" Binding="{Binding RemoteEndpoint}" Width="160"/>
                <DataGridTextColumn Header="Хост (DNS)" Binding="{Binding RemoteHost}" Width="160"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*"/>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🔌  Закрыть соединение" Click="CloseConn_Click"/>
                    <MenuItem Header="✖  Завершить процесс" Click="Kill_Click"/>
                    <MenuItem Header="⏸  Приостановить процесс" Click="Suspend_Click"/>
                    <MenuItem Header="▶  Возобновить процесс" Click="Resume_Click"/>
                    <Separator/>
                    <MenuItem Header="Приоритет процесса">
                        <MenuItem Header="Низкий (Idle)"          Tag="Idle"        Click="Priority_Click"/>
                        <MenuItem Header="Ниже среднего"          Tag="BelowNormal" Click="Priority_Click"/>
                        <MenuItem Header="Обычный"                Tag="Normal"      Click="Priority_Click"/>
                        <MenuItem Header="Выше среднего"          Tag="AboveNormal" Click="Priority_Click"/>
                        <MenuItem Header="Высокий"                Tag="High"        Click="Priority_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="🛡  Заблокировать в брандмауэре" Click="Block_Click"/>
                    <MenuItem Header="🛡  Разблокировать в брандмауэре" Click="Unblock_Click"/>
                    <Separator/>
                    <MenuItem Header="🌐  Определить хост (обратный DNS)" Click="Resolve_Click"/>
                    <MenuItem Header="📁  Открыть расположение файла" Click="OpenLocation_Click"/>
                    <MenuItem Header="📋  Копировать строку" Click="Copy_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="False" Margin="0,1"
                                                  Background="{StaticResource PanelBrush2}"
                                                  Foreground="{StaticResource FgBrush}"
                                                  BorderBrush="{StaticResource BorderBrush2}"
                                                  BorderThickness="0,0,0,1">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' — соединений: {0}'}"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="2,8,2,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>
    </Grid>
</Window>

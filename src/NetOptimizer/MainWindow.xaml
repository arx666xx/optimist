<Window x:Class="NetOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOptimizer"
        Height="800" Width="1400"
        MinHeight="560" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP BAR ============ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="22,16,22,14" LastChildFill="False">
                <!-- Wordmark -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <TextBlock Text="NET" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="OPTIMIZER" FontSize="17" FontWeight="Light" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- View switcher -->
                <Border DockPanel.Dock="Left" Margin="30,0,0,0" Style="{StaticResource Segment}"
                        Background="{DynamicResource PanelBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnViewConn" Content="Сеть" Style="{StaticResource TabBtn}"
                                Tag="active" Click="ShowConnections_Click"/>
                        <Button x:Name="BtnViewStats" Content="Статистика" Style="{StaticResource TabBtn}"
                                Tag="inactive" Margin="3,0,0,0" Click="ShowStats_Click"/>
                        <Button x:Name="BtnViewDiag" Content="Диагностика" Style="{StaticResource TabBtn}"
                                Tag="inactive" Margin="3,0,0,0" Click="ShowDiag_Click"/>
                        <Button x:Name="BtnViewLog" Content="Журнал Windows" Style="{StaticResource TabBtn}"
                                Tag="inactive" Margin="3,0,0,0" Click="ShowLog_Click"/>
                    </StackPanel>
                </Border>

                <Button Content="Настройки" DockPanel.Dock="Right" Style="{StaticResource Btn}"
                        Click="Settings_Click"/>
                <Button x:Name="BtnUpdate" Content="Обновления" DockPanel.Dock="Right" Margin="0,0,9,0"
                        Style="{StaticResource Btn}" Click="Update_Click"/>
            </DockPanel>

            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderBrush2}"/>
        </Grid>

        <!-- ============ NETWORK VIEW (apps + raw connections) ============ -->
        <Grid x:Name="ConnectionsView" Grid.Row="1" Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">
                    <TextBox x:Name="FilterBox" Width="240" Style="{StaticResource SearchBox}"
                             Tag="Поиск: программа, сервер, порт"
                             TextChanged="FilterBox_TextChanged"/>

                    <Border Style="{StaticResource Segment}" Margin="12,0,0,0">
                        <StackPanel x:Name="ScopePanel" Orientation="Horizontal">
                            <Button Content="В сети" CommandParameter="online" Style="{StaticResource TabBtn}" Tag="active"
                                    ToolTip="Программы, которые сейчас обмениваются данными с интернетом" Click="Scope_Click"/>
                            <Button Content="Все" CommandParameter="all" Style="{StaticResource TabBtn}" Tag="inactive"
                                    Margin="3,0,0,0" Click="Scope_Click"/>
                            <Button Content="Подозрительные" CommandParameter="suspicious" Style="{StaticResource TabBtn}" Tag="inactive"
                                    Margin="3,0,0,0" Click="Scope_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Ускорить" DockPanel.Dock="Right" Margin="9,0,0,0" MinWidth="120"
                            Style="{StaticResource BtnAccent}"
                            ToolTip="Освободить память и интернет-канал"
                            Click="Boost_Click"/>
                    <Button Content="Ремонт сети" DockPanel.Dock="Right" Margin="9,0,0,0"
                            Style="{StaticResource Btn}" Click="Repair_Click"/>

                    <Border Style="{StaticResource Segment}" DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnModeApps" Content="Приложения" Style="{StaticResource TabBtn}" Tag="active"
                                    Click="ModeApps_Click"/>
                            <Button x:Name="BtnModeRaw" Content="Соединения" Style="{StaticResource TabBtn}" Tag="inactive"
                                    Margin="3,0,0,0" ToolTip="Подробный список всех сетевых соединений"
                                    Click="ModeRaw_Click"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Extra tools for the detailed (raw) mode only -->
            <DockPanel x:Name="RawTools" Grid.Row="1" Margin="4,0,0,12" LastChildFill="False" Visibility="Collapsed">
                <CheckBox x:Name="HideLoopback" Content="Скрыть внутренние (localhost)" IsChecked="True"
                          VerticalAlignment="Center" Click="Filter_Changed"/>
                <CheckBox x:Name="GroupByProcess" Content="Группировать по программе" Margin="18,0,0,0"
                          VerticalAlignment="Center" Click="GroupBy_Changed"/>
                <CheckBox x:Name="AutoRefresh" Content="Обновлять автоматически" Margin="18,0,0,0"
                          IsChecked="True" VerticalAlignment="Center" Click="AutoRefresh_Changed"/>

                <Button Content="Экспорт" DockPanel.Dock="Right" Margin="9,0,0,0"
                        Style="{StaticResource Btn}" Click="Export_Click"/>
                <Button Content="Столбцы" DockPanel.Dock="Right" Margin="9,0,0,0"
                        Style="{StaticResource Btn}" Click="Columns_Click"/>
                <Button Content="Обновить" DockPanel.Dock="Right"
                        Style="{StaticResource Btn}" Click="Refresh_Click"/>
            </DockPanel>

            <!-- ===== Simple mode: one row per application + details ===== -->
            <Grid x:Name="AppsPane" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column captions -->
                        <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="20,10,24,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="1" Text="↓ ПРИЁМ" Style="{StaticResource Caption}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="↑ ОТДАЧА" Style="{StaticResource Caption}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="ЗА СЕАНС" Style="{StaticResource Caption}" TextAlignment="Right"
                                           ToolTip="Сколько приложение скачало и отправило с момента запуска NetOptimizer"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="AppList" Grid.Row="1" Style="{StaticResource AppList}"
                                 ItemContainerStyle="{StaticResource AppListItem}"
                                 SelectionChanged="AppList_SelectionChanged"
                                 MouseDoubleClick="AppList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="0,0,8,0"/>
                                                <Border Style="{StaticResource Badge}" Background="{DynamicResource SuspiciousBg}"
                                                        Visibility="{Binding Suspicious, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Программа запущена из временной папки или загрузок и выходит в интернет">
                                                    <TextBlock Text="Подозрительное" FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Background="{DynamicResource WarnSoft}"
                                                        Visibility="{Binding Unsigned, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="У файла программы нет цифровой подписи издателя">
                                                    <TextBlock Text="Без подписи" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Activity}" Style="{StaticResource Muted}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DownRateText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource OkBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UpRateText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource AccentBrush2}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TotalText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource FgBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Ускорить это приложение" Click="AppBoost_Click"/>
                                    <MenuItem Header="Показать все соединения" Click="AppShowConnections_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Запретить доступ в интернет" Click="AppBlock_Click"/>
                                    <MenuItem Header="Разрешить доступ в интернет" Click="AppUnblock_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Приостановить" Click="AppSuspend_Click"/>
                                    <MenuItem Header="Возобновить" Click="AppResume_Click"/>
                                    <MenuItem Header="Завершить" Click="AppKill_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Открыть папку программы" Click="AppOpenLocation_Click"/>
                                    <MenuItem Header="Доверять / не доверять" Click="AppTrust_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <TextBlock x:Name="AppsEmpty" Grid.Row="1" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="360"
                                   Text="Сейчас ни одно приложение не выходит в интернет."/>
                    </Grid>
                </Border>

                <!-- Details -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock x:Name="DetailsEmpty" Margin="28" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Style="{StaticResource Muted}"
                                   Text="Выберите приложение, чтобы увидеть, с какими серверами оно связано и что с ним можно сделать."/>

                        <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="20,18,20,20">
                                <DockPanel Margin="0,0,0,12">
                                    <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Top"
                                           Margin="0,2,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock x:Name="DetailServices" Style="{StaticResource Muted}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock x:Name="DetailPath" Text="{Binding ProcessPath}" Style="{StaticResource Mono}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- Speed -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Text="ПРИЁМ" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding DownRateText}" Foreground="{DynamicResource OkBrush}"
                                                       FontSize="14" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="ОТДАЧА" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding UpRateText}" Foreground="{DynamicResource AccentBrush2}"
                                                       FontSize="14" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="ЗА СЕАНС" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding TotalText}" FontSize="14" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>

                                <!-- Actions -->
                                <TextBlock Text="ДЕЙСТВИЯ" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                                <Button Content="Ускорить это приложение" Style="{StaticResource BtnAccent}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="AppBoost_Click"/>
                                <UniformGrid Columns="2">
                                    <Button Content="Запретить интернет" Style="{StaticResource Btn}" MinWidth="0"
                                            Margin="0,0,4,8" Click="AppBlock_Click"
                                            ToolTip="Правило брандмауэра Windows: программа не сможет выходить в сеть"/>
                                    <Button Content="Разрешить снова" Style="{StaticResource Btn}" MinWidth="0"
                                            Margin="4,0,0,8" Click="AppUnblock_Click"/>
                                    <Button x:Name="BtnAppSuspend" Content="Приостановить" Style="{StaticResource Btn}" MinWidth="0"
                                            Margin="0,0,4,8" Click="AppSuspend_Click"/>
                                    <Button Content="Возобновить" Style="{StaticResource Btn}" MinWidth="0"
                                            Margin="4,0,0,8" Click="AppResume_Click"/>
                                    <Button Content="Открыть папку" Style="{StaticResource Btn}" MinWidth="0"
                                            Margin="0,0,4,8" Click="AppOpenLocation_Click"/>
                                    <Button x:Name="BtnAppTrust" Content="Доверять" Style="{StaticResource Btn}" MinWidth="0"
                                            Margin="4,0,0,8" Click="AppTrust_Click"
                                            ToolTip="Доверенные программы не помечаются как подозрительные"/>
                                </UniformGrid>
                                <Button Content="Завершить приложение" Style="{StaticResource BtnDanger}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,22" Click="AppKill_Click"/>
                                <!-- Servers -->
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock Text="С КЕМ СВЯЗАНО" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCountries" DockPanel.Dock="Right" Content="Определить страны"
                                            Style="{StaticResource TabBtn}" FontSize="12" Click="AppCountries_Click"
                                            ToolTip="Запросить страну каждого сервера у сервиса ipwho.is"/>
                                </DockPanel>
                                <ItemsControl x:Name="RemoteList" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Address}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Country}" Style="{StaticResource Muted}"
                                                           FontSize="12" VerticalAlignment="Top" Margin="10,1,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="RemoteEmpty" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Text="Сейчас ни с одним сервером не связано."/>
                                <TextBlock x:Name="ListeningText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Detailed mode: every connection ===== -->
            <Border x:Name="RawPane" Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True" Visibility="Collapsed">
                <DataGrid x:Name="ConnGrid" Margin="0,0,0,4"
                          Style="{StaticResource Dg}" RowStyle="{StaticResource DgRow}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserResizeRows="False"
                          SelectionMode="Extended" HeadersVisibility="Column"
                          PreviewMouseRightButtonDown="ConnGrid_RightClick"
                          PreviewKeyDown="ConnGrid_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ПРОГРАММА" Width="200" SortMemberPath="ProcessName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ProcessPath}">
                                        <Image Source="{Binding Icon}" Width="16" Height="16"
                                               Margin="0,0,9,0" SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ОПИСАНИЕ" Width="190" SortMemberPath="Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedBrush}"
                                               ToolTip="{Binding Description}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="СЕРВЕР" Width="200" SortMemberPath="RemoteEndpoint">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RemoteEndpoint}" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteEndpoint}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="НАЗНАЧЕНИЕ" Width="170" SortMemberPath="ServiceText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ServiceText}" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ИМЯ СЕРВЕРА" Binding="{Binding RemoteHost}" Width="160"/>

                        <DataGridTemplateColumn Header="СОСТОЯНИЕ" Width="150" SortMemberPath="StateText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" ToolTip="{Binding State}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="ESTABLISHED">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="LISTENING">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Technical columns: hidden by default, enabled via «Столбцы». -->
                        <DataGridTextColumn Header="ПРОТОКОЛ" Binding="{Binding Protocol}" Width="86" Visibility="Collapsed"/>

                        <DataGridTemplateColumn Header="PID" Width="70" SortMemberPath="Pid" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pid}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ЛОКАЛЬНЫЙ АДРЕС" Width="170" SortMemberPath="LocalEndpoint" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LocalEndpoint}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="СТРАНА" Binding="{Binding Country}" Width="140" Visibility="Collapsed"/>

                        <DataGridTemplateColumn Header="ПОДПИСЬ" Width="110" SortMemberPath="Signature" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Signature}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Signature}" Value="Не подписан">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="↓ ПРИЁМ ПРОЦЕССА" Width="130" SortMemberPath="DownloadRate" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DownloadRateText}" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="↑ ОТДАЧА ПРОЦЕССА" Width="130" SortMemberPath="UploadRate" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UploadRateText}" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource AccentBrush2}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Закрыть соединение" Click="CloseConn_Click"/>
                            <MenuItem Header="Завершить процесс" Click="Kill_Click"/>
                            <MenuItem Header="Приостановить процесс" Click="Suspend_Click"/>
                            <MenuItem Header="Возобновить процесс" Click="Resume_Click"/>
                            <Separator/>
                            <MenuItem Header="Приоритет процесса">
                                <MenuItem Header="Низкий (Idle)"  Tag="Idle"        Click="Priority_Click"/>
                                <MenuItem Header="Ниже среднего"  Tag="BelowNormal" Click="Priority_Click"/>
                                <MenuItem Header="Обычный"        Tag="Normal"      Click="Priority_Click"/>
                                <MenuItem Header="Выше среднего"  Tag="AboveNormal" Click="Priority_Click"/>
                                <MenuItem Header="Высокий"        Tag="High"        Click="Priority_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Заблокировать в брандмауэре" Click="Block_Click"/>
                            <MenuItem Header="Разблокировать в брандмауэре" Click="Unblock_Click"/>
                            <Separator/>
                            <MenuItem Header="Определить имя сервера" Click="Resolve_Click"/>
                            <MenuItem Header="Определить страну" Click="GeoIp_Click"/>
                            <MenuItem Header="Добавить процесс в доверенные" Click="Trust_Click"/>
                            <MenuItem Header="Убрать из доверенных" Click="Untrust_Click"/>
                            <Separator/>
                            <MenuItem Header="Открыть расположение файла" Click="OpenLocation_Click"/>
                            <MenuItem Header="Копировать строку" Click="Copy_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="False" Margin="0"
                                                          Background="Transparent"
                                                          Foreground="{DynamicResource FgBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush2}"
                                                          BorderThickness="0,0,0,1">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </Border>

            <!-- Status line -->
            <DockPanel Grid.Row="3" Margin="4,12,4,0" LastChildFill="False">
                <TextBlock x:Name="StatusText" Text="Готово" Style="{StaticResource Mono}"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Mono}"/>
            </DockPanel>
        </Grid>

        <!-- ============ WINDOWS LOG VIEW ============ -->
        <Grid x:Name="LogView" Grid.Row="1" Margin="22,18,22,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">
                    <Border Style="{StaticResource Segment}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLogSystem"   Content="Система"      Style="{StaticResource TabBtn}" Tag="active"   Click="LogSource_Click"/>
                            <Button x:Name="BtnLogApp"      Content="Приложения"   Style="{StaticResource TabBtn}" Tag="inactive" Margin="3,0,0,0" Click="LogSource_Click"/>
                            <Button x:Name="BtnLogSecurity" Content="Безопасность" Style="{StaticResource TabBtn}" Tag="inactive" Margin="3,0,0,0" Click="LogSource_Click"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="LogOnlyErrors" Content="Только ошибки и предупреждения" Margin="18,0,0,0"
                              IsChecked="True" VerticalAlignment="Center" Click="LogOnlyErrors_Changed"/>
                    <CheckBox x:Name="LogHideHarmless" Content="Скрыть безвредные" Margin="18,0,0,0"
                              IsChecked="True" VerticalAlignment="Center" Click="LogHideHarmless_Changed"
                              ToolTip="Не показывать известный безвредный «шум», который Windows пишет постоянно"/>

                    <Button Content="Обновить" DockPanel.Dock="Right" Margin="9,0,0,0" Style="{StaticResource Btn}" Click="RefreshLog_Click"/>
                    <TextBox x:Name="LogSearch" Width="240" DockPanel.Dock="Right" Style="{StaticResource SearchBox}"
                             Tag="Поиск в журнале"
                             TextChanged="LogSearch_TextChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                <DataGrid x:Name="LogGrid" Margin="0,0,0,4"
                          Style="{StaticResource Dg}" RowStyle="{StaticResource LogRow}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserResizeRows="False"
                          SelectionMode="Single" HeadersVisibility="Column"
                          SelectionChanged="LogGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ДАТА И ВРЕМЯ" Width="170" SortMemberPath="Time">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="УРОВЕНЬ" Width="140" SortMemberPath="Level">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Level}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Ошибка">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Предупреждение">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ЧТО ПРОИЗОШЛО" Width="*" SortMemberPath="Summary">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ИСТОЧНИК" Width="200" SortMemberPath="Source">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="{Binding Source}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="КОД" Binding="{Binding EventId}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Full text of the selected event -->
            <Border x:Name="LogDetails" Grid.Row="2" Style="{StaticResource Card}" Padding="18,14"
                    Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LogDetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="LogDetailMeta" Style="{StaticResource Mono}" FontSize="11" Margin="0,0,0,8"/>
                    <TextBox x:Name="LogDetailText" Style="{StaticResource ConsoleBox}" MaxHeight="160"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="3" Margin="4,12,4,0" LastChildFill="False">
                <TextBlock x:Name="LogStatus" Text="Откройте вкладку, чтобы загрузить журнал."
                           Style="{StaticResource Mono}"/>
            </DockPanel>
        </Grid>


        <!-- ============ STATISTICS VIEW ============ -->
        <Grid x:Name="StatsView" Grid.Row="1" Margin="22,18,22,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">
                    <Border Style="{StaticResource Segment}">
                        <StackPanel x:Name="PeriodPanel" Orientation="Horizontal">
                            <Button Content="Сессия"   CommandParameter="0"  Style="{StaticResource TabBtn}" Tag="active"   Click="Period_Click"/>
                            <Button Content="Сегодня"  CommandParameter="1"  Style="{StaticResource TabBtn}" Tag="inactive" Margin="3,0,0,0" Click="Period_Click"/>
                            <Button Content="7 дней"   CommandParameter="7"  Style="{StaticResource TabBtn}" Tag="inactive" Margin="3,0,0,0" Click="Period_Click"/>
                            <Button Content="30 дней"  CommandParameter="30" Style="{StaticResource TabBtn}" Tag="inactive" Margin="3,0,0,0" Click="Period_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Очистить статистику" DockPanel.Dock="Right" Margin="9,0,0,0"
                            Style="{StaticResource Btn}" Click="ClearStats_Click"/>
                    <Button Content="Обновить" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="RefreshStats_Click"/>
                </DockPanel>
            </Border>

            <!-- Totals -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,48,0">
                        <TextBlock Text="ПРИНЯТО" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatsTotalDown" Text="—" FontSize="24" FontWeight="Light"
                                   Foreground="{DynamicResource OkBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,48,0">
                        <TextBlock Text="ОТДАНО" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatsTotalUp" Text="—" FontSize="24" FontWeight="Light"
                                   Foreground="{DynamicResource AccentBrush2}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ВСЕГО" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatsTotalAll" Text="—" FontSize="24" FontWeight="Light"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Per-application breakdown -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StatsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,9,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Rectangle Grid.Column="1" Height="6" RadiusX="3" RadiusY="3"
                                               Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource AccentGradient}"/>

                                    <Polyline Grid.Column="2" Points="{Binding Spark}" Margin="18,0,18,0"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Opacity="0.75"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DownText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource OkBrush}" Width="86" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding UpText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource AccentBrush2}" Width="86" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource FgBrush}" Width="92" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="3" Margin="4,12,4,0" LastChildFill="False">
                <TextBlock x:Name="StatsStatus" Style="{StaticResource Mono}" Text=""/>
            </DockPanel>
        </Grid>

        <!-- ============ DIAGNOSTICS VIEW ============ -->
        <Grid x:Name="DiagView" Grid.Row="1" Margin="22,18,22,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="DiagVerdict" Text="Проверка соединения от вашего компьютера наружу"
                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Адаптер → роутер → внешний узел → DNS → HTTPS, плюс типичные следы VPN"
                                   Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <Button x:Name="BtnDiagRun" Content="Проверить сеть" DockPanel.Dock="Right"
                            VerticalAlignment="Center" Style="{StaticResource BtnAccent}" Click="DiagRun_Click"/>
                    <Button x:Name="BtnDiagCopy" Content="Копировать отчёт" DockPanel.Dock="Right" Margin="0,0,9,0"
                            VerticalAlignment="Center" Style="{StaticResource Btn}" Click="DiagCopy_Click"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiagList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" FontWeight="Bold"
                                               VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Top"
                                               TextWrapping="Wrap" Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource WarnBrush}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Advice}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ SETTINGS SLIDE-OUT PANEL ============ -->
        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
            <Border Background="#B0000000" MouseLeftButtonDown="SettingsScrim_Click"/>
            <Border Width="340" HorizontalAlignment="Left"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide" X="-340"/>
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20,22,26">

                        <DockPanel Margin="0,0,0,22" LastChildFill="False">
                            <TextBlock Text="Настройки" Style="{StaticResource H1}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button Content="✕" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Закрыть" Click="CloseSettings_Click"/>
                        </DockPanel>

                        <!-- Theme -->
                        <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="BtnDark"  Content="Тёмная"  Style="{StaticResource TabBtn}" Tag="active"   Width="110" Click="Dark_Click"/>
                            <Button x:Name="BtnLight" Content="Светлая" Style="{StaticResource TabBtn}" Tag="inactive" Width="110" Margin="8,0,0,0" Click="Light_Click"/>
                        </StackPanel>

                        <!-- Reboot timer -->
                        <TextBlock Text="ТАЙМЕР АВТОПЕРЕЗАГРУЗКИ" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"
                                   Text="После действий, требующих перезагрузки (сброс Winsock, TCP/IP). При «0 сек» программа спросит перед перезагрузкой."/>
                        <WrapPanel x:Name="TimerPanel" Margin="0,0,0,24">
                            <Button Content="5 мин" CommandParameter="300" Style="{StaticResource TabBtn}" Tag="inactive" Width="88" Margin="0,0,7,7" Click="Timer_Click"/>
                            <Button Content="4 мин" CommandParameter="240" Style="{StaticResource TabBtn}" Tag="inactive" Width="88" Margin="0,0,7,7" Click="Timer_Click"/>
                            <Button Content="3 мин" CommandParameter="180" Style="{StaticResource TabBtn}" Tag="inactive" Width="88" Margin="0,0,7,7" Click="Timer_Click"/>
                            <Button Content="2 мин" CommandParameter="120" Style="{StaticResource TabBtn}" Tag="inactive" Width="88" Margin="0,0,7,7" Click="Timer_Click"/>
                            <Button Content="1 мин" CommandParameter="60"  Style="{StaticResource TabBtn}" Tag="inactive" Width="88" Margin="0,0,7,7" Click="Timer_Click"/>
                            <Button Content="0 сек" CommandParameter="0"   Style="{StaticResource TabBtn}" Tag="inactive" Width="88" Margin="0,0,7,7" Click="Timer_Click"/>
                        </WrapPanel>

                        <!-- Update -->
                        <TextBlock Text="ОБНОВЛЕНИЕ ПРОГРАММЫ" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="UpdateVersionText" Style="{StaticResource Mono}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" Text="Установленная версия: —"/>
                        <Button x:Name="BtnUpdateApp" Content="Обновить приложение"
                                HorizontalAlignment="Stretch" Style="{StaticResource BtnAccent}"
                                Margin="0,0,0,10" Click="UpdateApp_Click"/>
                        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1"
                                     Visibility="Collapsed" Margin="0,0,0,10"/>
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="12"
                                   Style="{StaticResource Muted}" Margin="0,0,0,26"
                                   Text="Скачивает новую версию из GitHub, сверяет контрольную сумму SHA-256, заменяет старый файл и удаляет ненужное."/>

                        <!-- Uninstall -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="УДАЛЕНИЕ ПРОГРАММЫ" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"
                                           Text="Удалит файл программы, вспомогательные файлы и настройки. Необратимо."/>
                                <Button x:Name="BtnUninstall" Content="Удалить программу"
                                        HorizontalAlignment="Stretch" Style="{StaticResource BtnDanger}" Click="Uninstall_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ SLIDE-IN PAGE (Ускорение / Ремонт сети) ============ -->
        <!-- Same idea as Settings, from the right: the page lives inside this
             window instead of opening a separate one. -->
        <Grid x:Name="PanelOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
            <Border Background="#B0000000" MouseLeftButtonDown="PanelScrim_Click"/>
            <Border x:Name="PanelFrame" HorizontalAlignment="Right"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide"/>
                </Border.RenderTransform>
                <Grid>
                    <ContentControl x:Name="PanelHost" Focusable="False"/>
                    <Button Content="✕" Style="{StaticResource BtnIcon}" ToolTip="Закрыть (Esc)"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0"
                            Click="ClosePanel_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

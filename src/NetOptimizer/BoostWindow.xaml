<Window x:Class="NetOptimizer.BoostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ускорение"
        Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🚀 Ускорение приложения" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                   Text="Выберите приложение (например игру) — ему будет поднят приоритет. Остальным фоновым приложениям можно понизить приоритет и закрыть их сетевые соединения, чтобы освободить канал и ресурсы. Системные процессы не затрагиваются."/>

        <TextBox x:Name="Search" Grid.Row="2" Style="{StaticResource SearchBox}" Margin="0,0,0,8"
                 TextChanged="Search_TextChanged"/>

        <ListBox x:Name="ProcList" Grid.Row="3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <CheckBox x:Name="LowerOthers" Content="Понизить приоритет остальных приложений" IsChecked="True" Margin="0,0,0,6"/>
            <CheckBox x:Name="CloseOthers" Content="Закрыть фоновые соединения остальных приложений (может отключить сеть у браузера и др.)" IsChecked="False"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="5" Height="90" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                 Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
                 BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="8"/>

        <DockPanel Grid.Row="6" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="Закрыть" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Close_Click"/>
            <Button x:Name="BtnBoost" Content="🚀 Ускорить" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Boost_Click"/>
            <Button Content="Сбросить приоритеты" DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="Reset_Click"/>
        </DockPanel>
    </Grid>
</Window>

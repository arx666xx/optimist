<Window x:Class="NetOptimizer.BoostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разгрузка сети"
        Height="660" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Разгрузка сети для приложения" Style="{StaticResource H1}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"
                   Text="Выберите приложение — например игру. Ему будет поднят приоритет процессора, а фоновым программам приоритет понижен и закрыты их сетевые соединения, чтобы они не занимали канал. Windows не умеет выдавать приложению больше скорости, поэтому канал освобождается именно за счёт остальных. Системные процессы не затрагиваются."/>

        <TextBlock Grid.Row="2" Text="ПРИЛОЖЕНИЕ" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
        <TextBox x:Name="Search" Grid.Row="3" Style="{StaticResource SearchBox}" Margin="0,0,0,9"
                 TextChanged="Search_TextChanged"/>

        <ListBox x:Name="ProcList" Grid.Row="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5" Margin="0,16,0,0">
            <CheckBox x:Name="LowerOthers" Content="Понизить приоритет остальных приложений" IsChecked="True" Margin="0,0,0,9"/>
            <CheckBox x:Name="CloseOthers" Content="Закрыть фоновые соединения остальных приложений" IsChecked="False"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="6" Height="88" Margin="0,16,0,0"
                 Style="{StaticResource ConsoleBox}" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <DockPanel Grid.Row="7" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Закрыть" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="9,0,0,0" Click="Close_Click"/>
            <Button x:Name="BtnBoost" Content="Разгрузить" DockPanel.Dock="Right" Style="{StaticResource BtnAccent}" Click="Boost_Click"/>
            <Button Content="Сбросить приоритеты" DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="Reset_Click"/>
        </DockPanel>
    </Grid>
</Window>
